{
  "compilerOptions": {
    "noImplicitAny": false,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "esModuleInterop": true,
    "module": "commonjs",
    "target": "es2019",
    "declaration": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}